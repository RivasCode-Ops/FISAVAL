# Com API (vários PCs/celulares no mesmo banco):
VITE_API_URL=http://127.0.0.1:8790

# Piloto local: esconde roteirização VROOM, push, import CSV, auditoria avançada (padrão: ativo)
VITE_PILOTO_LOCAL=true

# Opcional: filtrar dados offline pelo mesmo tenant da API
# Tenant (header X-Tenant-Id) — obrigatório se MULTI_TENANT na API
# VITE_TENANT_ID=demo
# VITE_SUPER_ADMIN_EMAILS=admin@demo

# Sem .env = só IndexedDB local (GitHub Pages)
